# Dependencies
node_modules/
.pnpm-store/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Unrelated tooling artifacts (slide decks, slide-runner state) that may land
# in the working copy from other workflows — not part of this project.
.slidep/
slides/
*.pptx

# Test-run snapshots (regenerated by tests/*.mjs on every run)
tests/last-page.html

# Timestamped test-run reports. Every suite run drops a fresh
# `run-<stamp>.md` / `actions-<stamp>.md` here, so keeping them would add a
# new file to every commit and bury the real diffs. Hand-written, versioned
# reports (tests/reports/TEST-REPORT-*.md) are deliberate deliverables and
# stay tracked.
tests/reports/run-*.md
tests/reports/actions-*.md

# Keep lib for local installs
# lib/
