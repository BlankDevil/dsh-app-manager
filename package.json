{
  "name": "dsh-app-manager",
  "version": "0.5.0",
  "description": "A CLI application manager for discovering, monitoring, and managing installed command-line tools across package managers. DSH plugin with web UI.",
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "bin": {
    "app-manager": "./lib/bin/cli-app-manager.js",
    "am": "./lib/bin/cli-app-manager.js"
  },
  "files": [
    "lib",
    "patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node lib/bin/cli-app-manager.js",
    "test": "node tests/run-tests.mjs",
    "test:quick": "node tests/run-tests.mjs --quick",
    "test:ui": "node tests/run-tests.mjs --group B,C,D",
    "test:drag": "node tests/drag-behavior.test.mjs",
    "test:perf": "node tests/perf-guard.test.mjs",
    "test:paths": "node tests/crossplatform-paths.test.mjs",
    "test:approval": "node tests/approval-gate.test.mjs",
    "smoke": "node tests/smoke-features.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "cli",
    "manager",
    "npm",
    "pnpm",
    "tools",
    "package-manager",
    "scoop",
    "choco"
  ],
  "author": "blank.devil.yang@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlankDevil/dsh-app-manager.git"
  },
  "bugs": {
    "url": "https://github.com/BlankDevil/dsh-app-manager/issues"
  },
  "homepage": "https://github.com/BlankDevil/dsh-app-manager#readme",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
